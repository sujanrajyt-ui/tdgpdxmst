# Local Hardhat deployment signer only. Never expose this value in VITE_* variables.
PRIVATE_KEY=0xreplace_with_a_testnet_only_deployer_private_key

# Public MST Testnet registry addresses (verified on chain 91562037).
VITE_MST_PRODUCT_PASSPORT_REGISTRY=0x38ca8F4d80d5882Ac0D75E6058fa5EF502b48A5C
VITE_MST_OWNERSHIP_REGISTRY=0x6aDA1f94033eF88bD44D5125204909A0C809feA8
VITE_MST_ATTESTATION_REGISTRY=0x47A4c4E56C83Fa226f0Dd5f5327C4EBdDa11e1FC
VITE_MST_LIFECYCLE_REGISTRY=0x480d6567d2dd395D8ff4d75e750Fdbd714b8f328
VITE_MST_SERVICE_REGISTRY=0x745795d9d6657fd9f1cE01b3880458b36ce7b4Ce

# Public contract addresses for API health reporting.
MST_PRODUCT_PASSPORT_REGISTRY=0x38ca8F4d80d5882Ac0D75E6058fa5EF502b48A5C
MST_OWNERSHIP_REGISTRY=0x6aDA1f94033eF88bD44D5125204909A0C809feA8

# Marketplace API. ADMIN_WALLETS contains comma-separated public wallet addresses.
API_HOST=127.0.0.1
API_PORT=8787
SESSION_HOURS=24
ADMIN_WALLETS=
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SAME_SITE=lax

# Local Vite uses the /api proxy when unset. Production uses same-origin Vercel Functions.
VITE_API_BASE_URL=

# Set in Vercel by attaching the Neon Postgres Marketplace integration.
DATABASE_URL=

# Configure a payment provider adapter before enabling checkout.
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
