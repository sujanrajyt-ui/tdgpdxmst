# Local Hardhat deployment signer only. Never expose this value in VITE_* variables.
PRIVATE_KEY=0xreplace_with_a_testnet_only_deployer_private_key

# Copy deployed contract addresses into .env.local for the Vite app.
VITE_MST_PRODUCT_PASSPORT_REGISTRY=
VITE_MST_OWNERSHIP_REGISTRY=
VITE_MST_ATTESTATION_REGISTRY=
VITE_MST_LIFECYCLE_REGISTRY=
VITE_MST_SERVICE_REGISTRY=

# Marketplace API. ADMIN_WALLETS contains comma-separated public wallet addresses.
API_HOST=127.0.0.1
API_PORT=8787
SESSION_HOURS=24
ADMIN_WALLETS=
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configure a payment provider adapter before enabling checkout.
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
